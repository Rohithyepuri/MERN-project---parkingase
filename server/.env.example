# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/parkease
CLIENT_ORIGIN=http://localhost:5173

# Generate: openssl rand -hex 32
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Signs QR entry tickets. Generate: openssl rand -hex 32
TICKET_HMAC_KEY=replace-me

# Razorpay TEST mode. Leave blank to run in labelled DEMO payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Minutes a pending booking holds its slot before it expires.
BOOKING_HOLD_MINUTES=10
